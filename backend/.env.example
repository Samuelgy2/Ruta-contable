# Copia este archivo a backend/.env y completa los valores. Nunca subas backend/.env a git.

# Servidor
PORT=3001
NODE_ENV=development
# Número de proxies de confianza delante del backend (Render=1, nginx=1, local sin proxy=0)
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Base de datos (Supabase, base única). DB_SSL=false solo para un Postgres local de pruebas.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# Sesión: usa un secreto aleatorio de 32 caracteres o más
JWT_SECRET=

# Correo (recuperación de clave)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# PayPal (solo sandbox; el servidor no arranca sin estas cuatro)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Club
CURRENCY=COP
CLUB_NAME=
